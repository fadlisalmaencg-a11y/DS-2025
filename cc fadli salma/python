        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy import stats\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv('/content/archive (1).zip')\n",
        "\n",
        "print(\"Data Quality Assessment Report\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "# Check for missing values\n",
        "print(\"\\n1. Missing Values:\")\n",
        "missing_values = df.isnull().sum()\n",
        "missing_percentage = (df.isnull().sum() / len(df)) * 100\n",
        "missing_report = pd.DataFrame({\n",
        "    'Missing Count': missing_values,\n",
        "    'Missing Percentage': missing_percentage\n",
        "})\n",
        "print(missing_report)\n",
        "\n",
        "# Check for duplicate rows\n",
        "print(f\"\\n2. Duplicate Rows: {df.duplicated().sum()}\")\n",
        "\n",
        "# Data type validation\n",
        "print(f\"\\n3. Data Types:\")\n",
        "print(df.dtypes)\n",
        "\n",
        "# Check for invalid values in target variable\n",
        "print(f\"\\n4. Target Variable Validation:\")\n",
        "unique_purchases = df['Purchased'].unique()\n",
        "print(f\"Unique values in 'Purchased': {sorted(unique_purchases)}\")\n",
        "valid_purchases = all(val in [0, 1] for val in unique_purchases)\n",
        "print(f\"Valid binary values: {valid_purchases}\")\n",
        "\n",
        "# Business-informed outlier detection\n",
        "print(f\"\\n5. Business-Informed Outlier Detection:\")\n",
        "\n",
        "# Age validation based on business context\n",
        "print(f\"Age Validation (Social Media + Salary Context):\")\n",
        "age_min_valid = 18  # Legal working age with salary\n",
        "age_max_valid = 80  # Reasonable upper limit for active social media users\n",
        "\n",
        "age_outliers_business = df[(df['Age'] < age_min_valid) | (df['Age'] > age_max_valid)]\n",
        "print(f\"Age outliers (business rules): {len(age_outliers_business)} records\")\n",
        "print(f\"Age valid range (business): {age_min_valid} to {age_max_valid}\")\n",
        "\n",
        "if len(age_outliers_business) > 0:\n",
        "    print(f\"Invalid ages found: {sorted(age_outliers_business['Age'].unique())}\")\n",
        "else:\n",
        "    print(\"All ages are within valid business range\")\n",
        "\n",
        "# Salary validation using multiple appropriate methods\n",
        "print(f\"\\nSalary Validation:\")\n",
        "\n",
        "# Method 1: Business-informed validation (most appropriate)\n",
        "salary_min_business = 15000   # Minimum wage considerations (~$7.50/hr × 2000 hrs)\n",
        "salary_max_business = 200000  # Reasonable upper limit for this dataset context\n",
        "\n",
        "salary_outliers_business = df[(df['EstimatedSalary'] < salary_min_business) | (df['EstimatedSalary'] > salary_max_business)]\n",
        "print(f\"Salary outliers (business rules): {len(salary_outliers_business)} records\")\n",
        "print(f\"Salary valid range (business): ${salary_min_business:,} to ${salary_max_business:,}\")\n",
        "\n",
        "# Method 2: Z-score method (better than IQR for salary)\n",
        "salary_zscore = np.abs(stats.zscore(df['EstimatedSalary']))\n",
        "salary_outliers_zscore = df[salary_zscore > 2.5]  # More conservative than 3\n",
        "print(f\"Salary outliers (Z-score > 2.5): {len(salary_outliers_zscore)} records\")\n",
        "\n",
        "# Method 3: Percentile-based (modified IQR that avoids negatives)\n",
        "Q1_salary = df['EstimatedSalary'].quantile(0.25)\n",
        "Q3_salary = df['EstimatedSalary'].quantile(0.75)\n",
        "IQR_salary = Q3_salary - Q1_salary\n",
        "\n",
        "# Use business minimum instead of negative lower bound\n",
        "salary_lower_percentile = max(salary_min_business, Q1_salary - 1.5 * IQR_salary)\n",
        "salary_upper_percentile = Q3_salary + 1.5 * IQR_salary\n",
        "\n",
        "salary_outliers_percentile = df[(df['EstimatedSalary'] < salary_lower_percentile) | (df['EstimatedSalary'] > salary_upper_percentile)]\n",
        "print(f\"Salary outliers (modified percentile): {len(salary_outliers_percentile)} records\")\n",
        "print(f\"Salary valid range (modified percentile): ${salary_lower_percentile:,.0f} to ${salary_upper_percentile:,.0f}\")\n",
        "\n",
        "# Show actual outliers if any\n",
        "if len(salary_outliers_business) > 0:\n",
        "    print(f\"\\nSalaries outside business range:\")\n",
        "    outlier_salaries = sorted(salary_outliers_business['EstimatedSalary'].unique())\n",
        "    for salary in outlier_salaries:\n",
        "        count = (salary_outliers_business['EstimatedSalary'] == salary).sum()\n",
        "        print(f\"  ${salary:,} ({count} records)\")\n",
        "else:\n",
        "    print(\"\\nAll salaries are within valid business range\")\n",
        "\n",
        "# Statistical outlier detection using Z-score\n",
        "print(f\"\\n6. Outlier Detection (Z-score > 3):\")\n",
        "age_zscore = np.abs(stats.zscore(df['Age']))\n",
        "salary_zscore = np.abs(stats.zscore(df['EstimatedSalary']))\n",
        "\n",
        "age_outliers_zscore = df[age_zscore > 3]\n",
        "salary_outliers_zscore = df[salary_zscore > 3]\n",
        "\n",
        "print(f\"Age outliers (Z-score): {len(age_outliers_zscore)} records\")\n",
        "print(f\"Salary outliers (Z-score): {len(salary_outliers_zscore)} records\")\n",
        "\n",
        "# Range validation\n",
        "print(f\"\\n7. Range Validation:\")\n",
        "print(f\"Age range: {df['Age'].min()} to {df['Age'].max()}\")\n",
        "print(f\"Salary range: {df['EstimatedSalary'].min()} to {df['EstimatedSalary'].max()}\")\n",
        "\n",
        "# Check for negative values\n",
        "negative_age = df[df['Age'] < 0]\n",
        "negative_salary = df[df['EstimatedSalary'] < 0]\n",
        "print(f\"Negative ages: {len(negative_age)} records\")\n",
        "print(f\"Negative salaries: {len(negative_salary)} records\")\n",
        "\n",
        "print(f\"\\n8. Data Quality Summary:\")\n",
        "print(f\"Total records: {len(df)}\")\n",
        "print(f\"Clean records (no missing, no duplicates): {len(df) - df.isnull().any(axis=1).sum() - df.duplicated().sum()}\")\n",
        "print(f\"Data quality score: {((len(df) - df.isnull().any(axis=1).sum() - df.duplicated().sum()) / len(df)) * 100:.1f}%\")"
      ]
    },
