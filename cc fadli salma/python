        "no_purchase_centroid = (no_purchase['Age'].mean(), no_purchase['EstimatedSalary'].mean())\n",
        "purchase_centroid = (purchase['Age'].mean(), purchase['EstimatedSalary'].mean())\n",
        "\n",
        "print(f\"\\nGroup Centroids:\")\n",
        "print(f\"No Purchase centroid: Age = {no_purchase_centroid[0]:.1f}, Salary = ${no_purchase_centroid[1]:,.0f}\")\n",
        "print(f\"Purchase centroid: Age = {purchase_centroid[0]:.1f}, Salary = ${purchase_centroid[1]:,.0f}\")\n",
        "\n",
        "# Distance between centroids\n",
        "centroid_distance = np.sqrt((purchase_centroid[0] - no_purchase_centroid[0])**2 +\n",
        "                           (purchase_centroid[1] - no_purchase_centroid[1])**2)\n",
        "print(f\"Distance between centroids: {centroid_distance:.2f}\")\n",
        "\n",
        "# 2. Quadrant analysis\n",
        "print(f\"\\n2. Quadrant Analysis:\")\n",
        "\n",
        "# Define quadrants based on median values\n",
        "age_median = df['Age'].median()\n",
        "salary_median = df['EstimatedSalary'].median()\n",
        "\n",
        "print(f\"Age median: {age_median}\")\n",
        "print(f\"Salary median: ${salary_median:,.0f}\")\n",
        "\n",
        "# Create quadrants\n",
        "quadrants = []\n",
        "for _, row in df.iterrows():\n",
        "    if row['Age'] <= age_median and row['EstimatedSalary'] <= salary_median:\n",
        "        quadrants.append('Q1: Young-Low_Salary')\n",
        "    elif row['Age'] <= age_median and row['EstimatedSalary'] > salary_median:\n",
        "        quadrants.append('Q2: Young-High_Salary')\n",
        "    elif row['Age'] > age_median and row['EstimatedSalary'] <= salary_median:\n",
        "        quadrants.append('Q3: Old-Low_Salary')\n",
        "    else:\n",
        "        quadrants.append('Q4: Old-High_Salary')\n",
        "\n",
        "df['Quadrant'] = quadrants\n",
        "\n",
        "# Analyze purchase rates by quadrant\n",
        "quadrant_analysis = df.groupby('Quadrant').agg({\n",
        "    'Purchased': ['count', 'sum', 'mean'],\n",
        "    'Age': 'mean',\n",
        "    'EstimatedSalary': 'mean'\n",
        "}).round(2)\n",
        "\n",
        "print(\"\\nQuadrant Purchase Analysis:\")\n",
        "print(quadrant_analysis)\n",
        "\n",
        "# 3. Clustering analysis to identify natural groupings\n",
        "print(f\"\\n3. Clustering Analysis:\")\n",
        "\n",
        "# Prepare data for clustering\n",
        "X = df[['Age', 'EstimatedSalary']].values\n",
        "\n",
        "# Standardize the features for clustering\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "# Determine optimal number of clusters using elbow method\n",
        "inertias = []\n",
        "K_range = range(1, 8)\n",
        "for k in K_range:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
        "    kmeans.fit(X_scaled)\n",
        "    inertias.append(kmeans.inertia_)\n",
        "\n",
        "print(\"Elbow Method Results:\")\n",
        "for k, inertia in zip(K_range, inertias):\n",
        "    print(f\"K={k}: Inertia = {inertia:.2f}\")\n",
        "\n",
        "# Apply K-means with optimal clusters (typically 3-4 for this type of data)\n",
        "optimal_k = 3\n",
        "kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n",
        "df['Cluster'] = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "# Analyze clusters\n",
        "print(f\"\\n4. Cluster Analysis (K={optimal_k}):\")\n",
        "cluster_analysis = df.groupby('Cluster').agg({\n",
        "    'Purchased': ['count', 'sum', 'mean'],\n",
        "    'Age': ['mean', 'std'],\n",
        "    'EstimatedSalary': ['mean', 'std']\n",
        "}).round(2)\n",
        "\n",
        "print(cluster_analysis)\n",
        "\n",
        "# 5. Density analysis\n",
        "print(f\"\\n5. Density Analysis:\")\n",
        "\n",
        "# Calculate point density in different regions\n",
        "age_bins = np.linspace(df['Age'].min(), df['Age'].max(), 5)\n",
        "salary_bins = np.linspace(df['EstimatedSalary'].min(), df['EstimatedSalary'].max(), 5)\n",
        "\n",
        "print(\"Purchase density by age-salary regions:\")\n",
        "for i in range(len(age_bins)-1):\n",
        "    for j in range(len(salary_bins)-1):\n",
        "        region_data = df[\n",
        "            (df['Age'] >= age_bins[i]) & (df['Age'] < age_bins[i+1]) &\n",
        "            (df['EstimatedSalary'] >= salary_bins[j]) & (df['EstimatedSalary'] < salary_bins[j+1])\n",
        "        ]\n",
        "\n",
        "        if len(region_data) > 0:\n",
        "            purchase_rate = region_data['Purchased'].mean()\n",
        "            print(f\"Age {age_bins[i]:.0f}-{age_bins[i+1]:.0f}, Salary ${salary_bins[j]:,.0f}-${salary_bins[j+1]:,.0f}: \"\n",
        "                  f\"{len(region_data)} users, {purchase_rate:.2%} purchase rate\")\n",
        "\n",
        "# 6. Outlier identification in scatter space\n",
        "print(f\"\\n6. Outlier Analysis:\")\n",
        "\n",
        "# Calculate distances from group centroids\n",
        "def calculate_distances_to_centroids(data):\n",
        "    distances_to_no_purchase = np.sqrt(\n",
        "        (data['Age'] - no_purchase_centroid[0])**2 +\n",
        "        (data['EstimatedSalary'] - no_purchase_centroid[1])**2\n",
        "    )\n",
        "    distances_to_purchase = np.sqrt(\n",
        "        (data['Age'] - purchase_centroid[0])**2 +\n",
        "        (data['EstimatedSalary'] - purchase_centroid[1])**2\n",
        "    )\n",
        "    return distances_to_no_purchase, distances_to_purchase\n",
        "\n",
        "dist_no_purchase, dist_purchase = calculate_distances_to_centroids(df)\n",
        "\n",
        "# Find outliers (points far from both centroids)\n",
        "threshold_percentile = 95\n",
        "threshold = np.percentile(np.minimum(dist_no_purchase, dist_purchase), threshold_percentile)\n",
        "\n",
        "outliers = df[np.minimum(dist_no_purchase, dist_purchase) > threshold]\n",
        "print(f\"Identified {len(outliers)} outliers (>{threshold_percentile}th percentile distance from centroids)\")\n",
        "print(f\"Outlier purchase rate: {outliers['Purchased'].mean():.2%}\")\n",
        "\n",
        "# 7. Purchase probability mapping\n",
        "print(f\"\\n7. Purchase Probability Mapping:\")\n",
        "\n",
        "# Create a grid for probability prediction\n",
        "age_grid = np.linspace(df['Age'].min(), df['Age'].max(), 20)\n",
        "salary_grid = np.linspace(df['EstimatedSalary'].min(), df['EstimatedSalary'].max(), 20)\n",
        "\n",
        "print(\"High-probability purchase regions (>60% purchase rate):\")\n",
        "high_prob_regions = []\n",
        "\n",
        "for i, age in enumerate(age_grid[:-1]):\n",
        "    for j, salary in enumerate(salary_grid[:-1]):\n",
        "        region_data = df[\n",
        "            (df['Age'] >= age) & (df['Age'] < age_grid[i+1]) &\n",
        "            (df['EstimatedSalary'] >= salary) & (df['EstimatedSalary'] < salary_grid[j+1])\n",
        "        ]\n",
        "\n",
        "        if len(region_data) >= 5:  # Minimum sample size\n",
        "            purchase_rate = region_data['Purchased'].mean()\n",
        "            if purchase_rate > 0.6:\n",
        "                high_prob_regions.append((age, salary, purchase_rate, len(region_data)))\n",
        "\n",
        "for age, salary, rate, count in high_prob_regions:\n",
        "    print(f\"Age {age:.0f}+, Salary ${salary:,.0f}+: {rate:.2%} purchase rate ({count} users)\")\n",
        "\n",
        "print(f\"\\n8. Scatter Plot Visualization:\")\n",
        "\n",
        "plt.figure(figsize=(12, 8))\n",
        "colors = ['red' if x == 0 else 'blue' for x in df['Purchased']]\n",
        "plt.scatter(df['Age'], df['EstimatedSalary'], c=colors, alpha=0.6)\n",
        "plt.xlabel('Age')\n",
        "plt.ylabel('Estimated Salary')\n",
        "plt.title('Age vs Salary by Purchase Decision')\n",
        "plt.axhline(y=df['EstimatedSalary'].median(), color='gray', linestyle='--', alpha=0.5)\n",
        "plt.axvline(x=df['Age'].median(), color='gray', linestyle='--', alpha=0.5)\n",
        "plt.legend(['No Purchase', 'Purchase'])\n",
        "plt.show()"
      ]
