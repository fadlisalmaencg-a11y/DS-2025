        "    base_model = RandomForestClassifier(random_state=42)\n",
        "    X_tune = X_train\n",
        "elif best_model_name == 'Decision Tree':\n",
        "    param_grid = {'max_depth': [None, 5, 10, 15], 'min_samples_split': [2, 5, 10]}\n",
        "    base_model = DecisionTreeClassifier(random_state=42)\n",
        "    X_tune = X_train\n",
        "else:\n",
        "    param_grid = {}\n",
        "    base_model = best_model['model']\n",
        "    X_tune = X_train_scaled if best_model_name in ['SVM (RBF)', 'K-Nearest Neighbors'] else X_train\n",
        "\n",
        "if param_grid:\n",
        "    grid_search = GridSearchCV(base_model, param_grid, cv=5, scoring='f1')\n",
