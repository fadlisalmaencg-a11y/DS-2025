      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.cluster import KMeans, DBSCAN, AgglomerativeClustering\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.mixture import GaussianMixture\n",
        "from sklearn.metrics import silhouette_score, calinski_harabasz_score\n",
        "from scipy.cluster.hierarchy import dendrogram, linkage\n",
        "from scipy.spatial.distance import pdist\n",
        "import matplotlib.pyplot as plt\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv('/content/archive (1).zip')\n",
        "\n",
        "print(\"Customer Segmentation Analysis Report\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "# Data preparation\n",
        "X = df[['Age', 'EstimatedSalary']].copy()\n",
        "\n",
        "print(f\"\\n1. Dataset Overview:\")\n",
        "print(f\"Total customers: {len(df)}\")\n",
        "print(f\"Features for segmentation: {list(X.columns)}\")\n",
        "print(f\"Age range: {X['Age'].min()} - {X['Age'].max()}\")\n",
        "print(f\"Salary range: ${X['EstimatedSalary'].min():,} - ${X['EstimatedSalary'].max():,}\")\n",
        "print(f\"Purchase rate: {df['Purchased'].mean():.2%}\")\n",
        "\n",
        "# Feature scaling for clustering\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "# 2. Optimal number of clusters analysis\n",
        "print(f\"\\n2. Optimal Number of Clusters Analysis:\")\n",
        "\n",
        "# Elbow method for K-means\n",
        "print(f\"\\nElbow Method (K-means):\")\n",
        "inertias = []\n",
        "silhouette_scores = []\n",
        "calinski_scores = []\n",
        "k_range = range(2, 11)\n",
        "\n",
        "for k in k_range:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
        "    cluster_labels = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "    inertias.append(kmeans.inertia_)\n",
        "    silhouette_scores.append(silhouette_score(X_scaled, cluster_labels))\n",
        "    calinski_scores.append(calinski_harabasz_score(X_scaled, cluster_labels))\n",
        "\n",
        "for k, inertia, sil_score, cal_score in zip(k_range, inertias, silhouette_scores, calinski_scores):\n",
        "    print(f\"K={k}: Inertia={inertia:.2f}, Silhouette={sil_score:.3f}, Calinski-Harabasz={cal_score:.2f}\")\n",
        "\n",
        "# Find optimal k using different criteria\n",
        "optimal_k_silhouette = k_range[np.argmax(silhouette_scores)]\n",
        "optimal_k_calinski = k_range[np.argmax(calinski_scores)]\n",
        "\n",
        "print(f\"\\nOptimal K by Silhouette Score: {optimal_k_silhouette} (score: {max(silhouette_scores):.3f})\")\n",
        "print(f\"Optimal K by Calinski-Harabasz: {optimal_k_calinski} (score: {max(calinski_scores):.2f})\")\n",
        "\n",
        "# Choose optimal k (typically 3-4 for this business context)\n",
        "optimal_k = optimal_k_silhouette\n",
        "\n",
        "# 3. K-Means Clustering\n",
        "print(f\"\\n3. K-Means Clustering (K={optimal_k}):\")\n",
        "\n",
        "kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n",
        "df['KMeans_Cluster'] = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "# Analyze K-means clusters\n",
        "print(f\"\\nK-Means Cluster Analysis:\")\n",
        "kmeans_summary = df.groupby('KMeans_Cluster').agg({\n",
        "    'Age': ['count', 'mean', 'std', 'min', 'max'],\n",
        "    'EstimatedSalary': ['mean', 'std', 'min', 'max'],\n",
        "    'Purchased': ['sum', 'mean']\n",
        "}).round(2)\n",
        "\n",
        "for cluster in range(optimal_k):\n",
        "    cluster_data = df[df['KMeans_Cluster'] == cluster]\n",
        "    print(f\"\\nCluster {cluster}:\")\n",
        "    print(f\"  Size: {len(cluster_data)} customers ({len(cluster_data)/len(df)*100:.1f}%)\")\n",
        "    print(f\"  Age: {cluster_data['Age'].mean():.1f} ± {cluster_data['Age'].std():.1f}\")\n",
        "    print(f\"  Salary: ${cluster_data['EstimatedSalary'].mean():,.0f} ± ${cluster_data['EstimatedSalary'].std():,.0f}\")\n",
        "    print(f\"  Purchase Rate: {cluster_data['Purchased'].mean():.2%}\")\n",
        "    print(f\"  Total Purchases: {cluster_data['Purchased'].sum()}\")\n",
        "\n",
        "# 4. Hierarchical Clustering\n",
        "print(f\"\\n4. Hierarchical Clustering:\")\n",
        "\n",
        "# Perform hierarchical clustering\n",
        "hierarchical = AgglomerativeClustering(n_clusters=optimal_k, linkage='ward')\n",
        "df['Hierarchical_Cluster'] = hierarchical.fit_predict(X_scaled)\n",
        "\n",
        "print(f\"\\nHierarchical Cluster Analysis:\")\n",
        "for cluster in range(optimal_k):\n",
        "    cluster_data = df[df['Hierarchical_Cluster'] == cluster]\n",
        "    print(f\"\\nCluster {cluster}:\")\n",
        "    print(f\"  Size: {len(cluster_data)} customers ({len(cluster_data)/len(df)*100:.1f}%)\")\n",
        "    print(f\"  Age: {cluster_data['Age'].mean():.1f} ± {cluster_data['Age'].std():.1f}\")\n",
        "    print(f\"  Salary: ${cluster_data['EstimatedSalary'].mean():,.0f} ± ${cluster_data['EstimatedSalary'].std():,.0f}\")\n",
        "    print(f\"  Purchase Rate: {cluster_data['Purchased'].mean():.2%}\")\n",
        "\n",
        "# 5. Gaussian Mixture Model Clustering\n",
        "print(f\"\\n5. Gaussian Mixture Model Clustering:\")\n",
        "\n",
        "gmm = GaussianMixture(n_components=optimal_k, random_state=42)\n",
        "df['GMM_Cluster'] = gmm.fit_predict(X_scaled)\n",
        "\n",
        "print(f\"\\nGMM Cluster Analysis:\")\n",
        "for cluster in range(optimal_k):\n",
        "    cluster_data = df[df['GMM_Cluster'] == cluster]\n",
        "    print(f\"\\nCluster {cluster}:\")\n",
        "    print(f\"  Size: {len(cluster_data)} customers ({len(cluster_data)/len(df)*100:.1f}%)\")\n",
        "    print(f\"  Age: {cluster_data['Age'].mean():.1f} ± {cluster_data['Age'].std():.1f}\")\n",
        "    print(f\"  Salary: ${cluster_data['EstimatedSalary'].mean():,.0f} ± ${cluster_data['EstimatedSalary'].std():,.0f}\")\n",
        "    print(f\"  Purchase Rate: {cluster_data['Purchased'].mean():.2%}\")\n",
        "\n",
        "# 6. DBSCAN Clustering (Density-based)\n",
        "print(f\"\\n6. DBSCAN Clustering:\")\n",
        "\n",
        "# Try different eps values to find optimal\n",
        "eps_values = [0.3, 0.5, 0.7, 0.9]\n",
        "best_eps = None\n",
        "best_score = -1\n",
        "best_n_clusters = 0\n",
        "\n",
        "for eps in eps_values:\n",
        "    dbscan = DBSCAN(eps=eps, min_samples=5)\n",
        "    cluster_labels = dbscan.fit_predict(X_scaled)\n",
        "\n",
        "    n_clusters = len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)\n",
        "    n_noise = list(cluster_labels).count(-1)\n",
        "\n",
        "    if n_clusters > 1 and n_noise < len(X) * 0.1:  # Less than 10% noise\n",
        "        try:\n",
        "            score = silhouette_score(X_scaled, cluster_labels)\n",
        "            if score > best_score:\n",
        "                best_score = score\n",
        "                best_eps = eps\n",
        "                best_n_clusters = n_clusters\n",
        "        except:\n",
        "            pass\n",
        "\n",
        "if best_eps is not None:\n",
        "    dbscan = DBSCAN(eps=best_eps, min_samples=5)\n",
        "    df['DBSCAN_Cluster'] = dbscan.fit_predict(X_scaled)\n",
        "\n",
        "    print(f\"Best eps: {best_eps}, Clusters: {best_n_clusters}\")\n",
        "    print(f\"Noise points: {list(df['DBSCAN_Cluster']).count(-1)}\")\n",
        "\n",
        "    for cluster in range(best_n_clusters):\n",
        "        cluster_data = df[df['DBSCAN_Cluster'] == cluster]\n",
        "        if len(cluster_data) > 0:\n",
        "            print(f\"\\nCluster {cluster}:\")\n",
        "            print(f\"  Size: {len(cluster_data)} customers\")\n",
        "            print(f\"  Age: {cluster_data['Age'].mean():.1f} ± {cluster_data['Age'].std():.1f}\")\n",
        "            print(f\"  Salary: ${cluster_data['EstimatedSalary'].mean():,.0f} ± ${cluster_data['EstimatedSalary'].std():,.0f}\")\n",
        "            print(f\"  Purchase Rate: {cluster_data['Purchased'].mean():.2%}\")\n",
        "else:\n",
        "    print(\"DBSCAN could not find suitable clusters with the given parameters\")\n",
        "    df['DBSCAN_Cluster'] = -1\n",
        "\n",
        "# 7. Business Segmentation Based on Purchase Behavior\n",
        "print(f\"\\n7. Business-Driven Segmentation:\")\n",
        "\n",
        "# Create segments based on business logic\n",
        "def create_business_segments(row):\n",
        "    age = row['Age']\n",
        "    salary = row['EstimatedSalary']\n",
        "\n",
        "    if age < 30:\n",
        "        if salary < 50000:\n",
        "            return \"Young_Low_Income\"\n",
        "        elif salary < 100000:\n",
        "            return \"Young_Middle_Income\"\n",
        "        else:\n",
        "            return \"Young_High_Income\"\n",
        "    elif age < 45:\n",
        "        if salary < 50000:\n",
        "            return \"Middle_Low_Income\"\n",
        "        elif salary < 100000:\n",
        "            return \"Middle_Middle_Income\"\n",
        "        else:\n",
        "            return \"Middle_High_Income\"\n",
        "    else:\n",
        "        if salary < 50000:\n",
        "            return \"Senior_Low_Income\"\n",
        "        elif salary < 100000:\n",
        "            return \"Senior_Middle_Income\"\n",
        "        else:\n",
        "            return \"Senior_High_Income\"\n",
        "\n",
        "df['Business_Segment'] = df.apply(create_business_segments, axis=1)\n",
        "\n",
        "print(f\"\\nBusiness Segment Analysis:\")\n",
        "business_segments = df.groupby('Business_Segment').agg({\n",
        "    'Age': 'count',\n",
        "    'Purchased': ['sum', 'mean']\n",
        "}).round(3)\n",
        "\n",
        "business_segments.columns = ['Count', 'Purchases', 'Purchase_Rate']\n",
        "business_segments['Revenue_Potential'] = business_segments['Count'] * business_segments['Purchase_Rate']\n",
        "\n",
        "# Sort by revenue potential\n",
        "business_segments_sorted = business_segments.sort_values('Revenue_Potential', ascending=False)\n",
        "print(business_segments_sorted)\n",
        "\n",
        "# 8. Segment Comparison\n",
        "print(f\"\\n8. Clustering Method Comparison:\")\n",
        "\n",
        "clustering_methods = ['KMeans_Cluster', 'Hierarchical_Cluster', 'GMM_Cluster']\n",
        "if 'DBSCAN_Cluster' in df.columns and df['DBSCAN_Cluster'].nunique() > 1:\n",
        "    clustering_methods.append('DBSCAN_Cluster')\n",
        "\n",
        "comparison_results = {}\n",
        "for method in clustering_methods:\n",
        "    valid_clusters = df[df[method] != -1] if method == 'DBSCAN_Cluster' else df\n",
        "\n",
        "    if len(valid_clusters) > 0:\n",
        "        try:\n",
        "            silhouette = silhouette_score(X_scaled[valid_clusters.index], valid_clusters[method])\n",
        "            comparison_results[method] = {\n",
        "                'silhouette': silhouette,\n",
        "                'n_clusters': valid_clusters[method].nunique(),\n",
        "                'purchase_rate_variance': valid_clusters.groupby(method)['Purchased'].mean().var()\n",
        "            }\n",
        "        except:\n",
        "            pass\n",
        "\n",
        "print(f\"Method Comparison:\")\n",
        "for method, metrics in comparison_results.items():\n",
        "    print(f\"{method}: Silhouette={metrics['silhouette']:.3f}, \"\n",
        "          f\"Clusters={metrics['n_clusters']}, \"\n",
        "          f\"Purchase Rate Variance={metrics['purchase_rate_variance']:.4f}\")\n",
        "\n",
        "# 9. Customer Segment Profiles\n",
        "print(f\"\\n9. Detailed Customer Segment Profiles (K-Means):\")\n",
        "\n",
        "for cluster in range(optimal_k):\n",
        "    cluster_data = df[df['KMeans_Cluster'] == cluster]\n",
        "\n",
        "    print(f\"\\n=== SEGMENT {cluster} PROFILE ===\")\n",
        "    print(f\"Segment Size: {len(cluster_data)} customers ({len(cluster_data)/len(df)*100:.1f}%)\")\n",
        "\n",
        "    # Demographics\n",
        "    print(f\"\\nDemographics:\")\n",
        "    print(f\"  Average Age: {cluster_data['Age'].mean():.1f} years\")\n",
        "    print(f\"  Age Range: {cluster_data['Age'].min()} - {cluster_data['Age'].max()}\")\n",
        "    print(f\"  Average Salary: ${cluster_data['EstimatedSalary'].mean():,.0f}\")\n",
        "    print(f\"  Salary Range: ${cluster_data['EstimatedSalary'].min():,} - ${cluster_data['EstimatedSalary'].max():,}\")\n",
        "\n",
        "    # Purchase behavior\n",
        "    print(f\"\\nPurchase Behavior:\")\n",
        "    print(f\"  Purchase Rate: {cluster_data['Purchased'].mean():.2%}\")\n",
        "    print(f\"  Total Purchases: {cluster_data['Purchased'].sum()}\")\n",
        "    print(f\"  Expected Revenue: ${cluster_data['Purchased'].sum() * 100:,}\") # Assuming $100 per purchase\n",
        "\n",
        "    # Segment characterization\n",
        "    if cluster_data['Age'].mean() < 35:\n",
        "        age_group = \"Young\"\n",
        "    elif cluster_data['Age'].mean() < 50:\n",
        "        age_group = \"Middle-aged\"\n",
        "    else:\n",
        "        age_group = \"Senior\"\n",
        "\n",
        "    if cluster_data['EstimatedSalary'].mean() < 60000:\n",
        "        income_level = \"Lower income\"\n",
        "    elif cluster_data['EstimatedSalary'].mean() < 100000:\n",
        "        income_level = \"Middle income\"\n",
        "    else:\n",
        "        income_level = \"Higher income\"\n",
        "\n",
        "    if cluster_data['Purchased'].mean() > 0.6:\n",
        "        purchase_propensity = \"High\"\n",
        "    elif cluster_data['Purchased'].mean() > 0.3:\n",
        "        purchase_propensity = \"Medium\"\n",
        "    else:\n",
        "        purchase_propensity = \"Low\"\n",
        "\n",
        "    print(f\"\\nSegment Characteristics: {age_group}, {income_level}, {purchase_propensity} purchase propensity\")\n",
        "\n",
        "# 10. Marketing Recommendations\n",
        "print(f\"\\n10. Marketing Strategy Recommendations:\")\n",
        "\n",
        "# Find the most valuable segment\n",
        "segment_value = []\n",
        "for cluster in range(optimal_k):\n",
        "    cluster_data = df[df['KMeans_Cluster'] == cluster]\n",
        "    size = len(cluster_data)\n",
        "    purchase_rate = cluster_data['Purchased'].mean()\n",
        "    value = size * purchase_rate\n",
        "    segment_value.append((cluster, value, size, purchase_rate))\n",
        "\n",
        "# Sort by value\n",
        "segment_value.sort(key=lambda x: x[1], reverse=True)\n",
        "\n",
        "print(f\"\\nSegment Priority Ranking (by revenue potential):\")\n",
        "for rank, (cluster, value, size, rate) in enumerate(segment_value, 1):\n",
        "    cluster_data = df[df['KMeans_Cluster'] == cluster]\n",
        "    print(f\"\\n{rank}. Segment {cluster}:\")\n",
        "    print(f\"   Revenue Potential: {value:.1f} purchases\")\n",
        "    print(f\"   Size: {size} customers\")\n",
        "    print(f\"   Purchase Rate: {rate:.2%}\")\n",
        "    print(f\"   Avg Age: {cluster_data['Age'].mean():.1f}\")\n",
        "    print(f\"   Avg Salary: ${cluster_data['EstimatedSalary'].mean():,.0f}\")\n",
        "\n",
        "    # Marketing recommendations\n",
        "    if rate > 0.6:\n",
        "        print(f\"   Strategy: Premium targeting - high conversion expected\")\n",
        "    elif rate > 0.3:\n",
        "        print(f\"   Strategy: Balanced approach - moderate investment\")\n",
        "    else:\n",
        "        print(f\"   Strategy: Low-cost awareness campaigns\")\n",
        "\n",
        "print(f\"\\n11. Customer Segmentation Visualization:\")\n",
        "\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "# Use a colormap to generate enough colors for any number of clusters\n",
        "import matplotlib.cm as cm\n",
        "import matplotlib.colors as mcolors\n",
        "\n",
        "# Generate colors dynamically based on number of clusters\n",
        "if optimal_k <= 10:\n",
        "    # Use predefined colors for small number of clusters\n",
        "    base_colors = ['red', 'blue', 'green', 'orange', 'purple', 'brown', 'pink', 'gray', 'olive', 'cyan']\n",
        "    colors = base_colors[:optimal_k]\n",
        "else:\n",
        "    # Use colormap for larger number of clusters\n",
        "    colors = cm.tab20(np.linspace(0, 1, optimal_k))\n",
        "\n",
        "print(f\"Creating visualization with {optimal_k} clusters...\")\n",
        "\n",
        "for cluster in range(optimal_k):\n",
        "    cluster_data = df[df['KMeans_Cluster'] == cluster]\n",
        "    if len(cluster_data) > 0:  # Only plot if cluster has data\n",
        "        plt.scatter(cluster_data['Age'], cluster_data['EstimatedSalary'],\n",
        "                   c=[colors[cluster]], label=f'Segment {cluster}', alpha=0.6, s=50)\n",
        "\n",
        "plt.xlabel('Age')\n",
        "plt.ylabel('Estimated Salary')\n",
        "plt.title(f'Customer Segments (K-Means Clustering, k={optimal_k})')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
