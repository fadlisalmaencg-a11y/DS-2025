        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from scipy import stats\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv('/content/archive (1).zip')\n",
        "\n",
        "print(\"Distribution Analysis Report\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "# 1. Overall distributions\n",
        "print(\"\\n1. Overall Distribution Statistics:\")\n",
        "print(\"\\nAge Distribution:\")\n",
        "print(f\"Mean: {df['Age'].mean():.2f}\")\n",
        "print(f\"Median: {df['Age'].median():.2f}\")\n",
        "print(f\"Mode: {df['Age'].mode().values[0]}\")\n",
        "print(f\"Standard Deviation: {df['Age'].std():.2f}\")\n",
        "print(f\"Skewness: {stats.skew(df['Age']):.3f}\")\n",
        "print(f\"Kurtosis: {stats.kurtosis(df['Age']):.3f}\")\n",
        "\n",
        "print(f\"\\nSalary Distribution:\")\n",
        "print(f\"Mean: {df['EstimatedSalary'].mean():.2f}\")\n",
        "print(f\"Median: {df['EstimatedSalary'].median():.2f}\")\n",
        "print(f\"Mode: {df['EstimatedSalary'].mode().values[0]}\")\n",
        "print(f\"Standard Deviation: {df['EstimatedSalary'].std():.2f}\")\n",
        "print(f\"Skewness: {stats.skew(df['EstimatedSalary']):.3f}\")\n",
        "print(f\"Kurtosis: {stats.kurtosis(df['EstimatedSalary']):.3f}\")\n",
        "\n",
        "# 2. Distributions by purchase status\n",
        "print(\"\\n2. Distribution by Purchase Status:\")\n",
        "\n",
        "# Age distribution by purchase\n",
        "age_no_purchase = df[df['Purchased'] == 0]['Age']\n",
        "age_purchase = df[df['Purchased'] == 1]['Age']\n",
        "\n",
        "print(f\"\\nAge Distribution Analysis:\")\n",
        "print(f\"No Purchase - Mean: {age_no_purchase.mean():.2f}, Std: {age_no_purchase.std():.2f}\")\n",
        "print(f\"Purchase - Mean: {age_purchase.mean():.2f}, Std: {age_purchase.std():.2f}\")\n",
        "\n",
        "# Salary distribution by purchase\n",
        "salary_no_purchase = df[df['Purchased'] == 0]['EstimatedSalary']\n",
        "salary_purchase = df[df['Purchased'] == 1]['EstimatedSalary']\n",
        "\n",
        "print(f\"\\nSalary Distribution Analysis:\")\n",
        "print(f\"No Purchase - Mean: {salary_no_purchase.mean():.2f}, Std: {salary_no_purchase.std():.2f}\")\n",
        "print(f\"Purchase - Mean: {salary_purchase.mean():.2f}, Std: {salary_purchase.std():.2f}\")\n",
        "\n",
        "# 3. Statistical tests for distribution differences\n",
        "print(\"\\n3. Statistical Tests for Distribution Differences:\")\n",
        "\n",
        "# T-test for age differences\n",
        "age_tstat, age_pvalue = stats.ttest_ind(age_no_purchase, age_purchase)\n",
        "print(f\"Age T-test: t-statistic = {age_tstat:.4f}, p-value = {age_pvalue:.6f}\")\n",
        "\n",
        "# T-test for salary differences\n",
        "salary_tstat, salary_pvalue = stats.ttest_ind(salary_no_purchase, salary_purchase)\n",
        "print(f\"Salary T-test: t-statistic = {salary_tstat:.4f}, p-value = {salary_pvalue:.6f}\")\n",
        "\n",
        "# Mann-Whitney U test (non-parametric)\n",
        "age_ustat, age_u_pvalue = stats.mannwhitneyu(age_no_purchase, age_purchase, alternative='two-sided')\n",
        "print(f\"Age Mann-Whitney U test: U-statistic = {age_ustat:.4f}, p-value = {age_u_pvalue:.6f}\")\n",
        "\n",
        "salary_ustat, salary_u_pvalue = stats.mannwhitneyu(salary_no_purchase, salary_purchase, alternative='two-sided')\n",
        "print(f\"Salary Mann-Whitney U test: U-statistic = {salary_ustat:.4f}, p-value = {salary_u_pvalue:.6f}\")\n",
        "\n",
        "# 4. Percentile analysis\n",
        "print(\"\\n4. Percentile Analysis:\")\n",
