        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.stats import pearsonr, spearmanr, chi2_contingency\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore', category=RuntimeWarning)\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv('/content/archive (1).zip')\n",
        "\n",
        "print(\"Correlation Analysis Report\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "# 1. Correlation matrix for all numerical variables\n",
        "print(\"\\n1. Pearson Correlation Matrix:\")\n",
        "correlation_matrix = df.corr()\n",
        "print(correlation_matrix)\n",
        "\n",
        "# 2. Specific correlations with target variable\n",
        "print(f\"\\n2. Feature Correlations with Target (Purchased):\")\n",
        "age_corr, age_p = pearsonr(df['Age'], df['Purchased'])\n",
        "salary_corr, salary_p = pearsonr(df['EstimatedSalary'], df['Purchased'])\n",
        "\n",
        "print(f\"Age vs Purchased:\")\n",
        "print(f\"  Pearson correlation: {age_corr:.4f} (p-value: {age_p:.4f})\")\n",
        "print(f\"Salary vs Purchased:\")\n",
        "print(f\"  Pearson correlation: {salary_corr:.4f} (p-value: {salary_p:.4f})\")\n",
        "\n",
        "# 3. Spearman correlation (non-parametric)\n",
        "print(f\"\\n3. Spearman Rank Correlations:\")\n",
        "age_spearman, age_spearman_p = spearmanr(df['Age'], df['Purchased'])\n",
        "salary_spearman, salary_spearman_p = spearmanr(df['EstimatedSalary'], df['Purchased'])\n",
        "\n",
        "print(f\"Age vs Purchased:\")\n",
        "print(f\"  Spearman correlation: {age_spearman:.4f} (p-value: {age_spearman_p:.4f})\")\n",
        "print(f\"Salary vs Purchased:\")\n",
        "print(f\"  Spearman correlation: {salary_spearman:.4f} (p-value: {salary_spearman_p:.4f})\")\n",
        "\n",
        "# 4. Feature correlation (Age vs Salary)\n",
        "age_salary_corr, age_salary_p = pearsonr(df['Age'], df['EstimatedSalary'])\n",
        "print(f\"\\n4. Age vs Salary Correlation:\")\n",
        "print(f\"Pearson correlation: {age_salary_corr:.4f} (p-value: {age_salary_p:.4f})\")\n",
        "\n",
        "# 5. Categorical analysis using binning\n",
        "print(f\"\\n5. Categorical Correlation Analysis:\")\n",
        "\n",
        "# Create age bins\n",
        "df['Age_Bin'] = pd.cut(df['Age'], bins=[0, 30, 40, 50, 100], labels=['Young', 'Middle', 'Senior', 'Elder'])\n",
        "\n",
        "# Create salary bins\n",
        "df['Salary_Bin'] = pd.cut(df['EstimatedSalary'], bins=[0, 50000, 100000, 200000], labels=['Low', 'Medium', 'High'])\n",
        "\n",
        "# Chi-square test for age bins and purchase\n",
        "age_crosstab = pd.crosstab(df['Age_Bin'], df['Purchased'])\n",
        "chi2_age, p_age, dof_age, expected_age = chi2_contingency(age_crosstab)\n",
        "print(f\"Age Categories vs Purchase - Chi-square: {chi2_age:.4f} (p-value: {p_age:.4f})\")\n",
        "\n",
        "# Chi-square test for salary bins and purchase\n",
        "salary_crosstab = pd.crosstab(df['Salary_Bin'], df['Purchased'])\n",
        "chi2_salary, p_salary, dof_salary, expected_salary = chi2_contingency(salary_crosstab)\n",
        "print(f\"Salary Categories vs Purchase - Chi-square: {chi2_salary:.4f} (p-value: {p_salary:.4f})\")\n",
        "\n",
        "# 6. Point-biserial correlation (for binary target)\n",
        "from scipy.stats import pointbiserialr\n",
        "\n",
        "age_pb_corr, age_pb_p = pointbiserialr(df['Purchased'], df['Age'])\n",
        "salary_pb_corr, salary_pb_p = pointbiserialr(df['Purchased'], df['EstimatedSalary'])\n",
        "\n",
        "print(f\"\\n6. Point-Biserial Correlations (Binary Target):\")\n",
        "print(f\"Age vs Purchased: {age_pb_corr:.4f} (p-value: {age_pb_p:.4f})\")\n",
