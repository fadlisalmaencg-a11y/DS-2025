        "    'Age': 'mean',\n",
        "    'EstimatedSalary': 'mean'\n",
        "})\n",
        "\n",
        "print(age_group_stats)\n",
        "\n",
        "# 6. Distribution by salary groups\n",
        "print(\"\\n6. Purchase Rate by Salary Groups:\")\n",
        "salary_bins = [0, 50000, 75000, 100000, 200000]\n",
        "salary_labels = ['Low (<50k)', 'Medium (50k-75k)', 'High (75k-100k)', 'Very High (>100k)']\n",
        "df['Salary_Group'] = pd.cut(df['EstimatedSalary'], bins=salary_bins, labels=salary_labels, right=True)\n",
        "\n",
        "salary_group_stats = df.groupby('Salary_Group').agg({\n",
        "    'Purchased': ['count', 'sum', 'mean'],\n",
        "    'Age': 'mean',\n",
        "    'EstimatedSalary': 'mean'\n",
        "})\n",
        "\n",
        "print(salary_group_stats)\n",
        "\n",
        "# 7. Normality tests\n",
        "print(\"\\n7. Normality Tests (Shapiro-Wilk):\")\n",
        "age_shapiro_stat, age_shapiro_p = stats.shapiro(df['Age'])\n",
        "salary_shapiro_stat, salary_shapiro_p = stats.shapiro(df['EstimatedSalary'])\n",
        "\n",
        "print(f\"Age normality test: W = {age_shapiro_stat:.4f}, p-value = {age_shapiro_p:.6f}\")\n",
        "print(f\"Salary normality test: W = {salary_shapiro_stat:.4f}, p-value = {salary_shapiro_p:.6f}\")\n",
        "\n",
        "print(f\"\\nDistribution Summary:\")\n",
        "print(f\"Age distribution: {'Normal' if age_shapiro_p > 0.05 else 'Non-normal'}\")\n",
        "print(f\"Salary distribution: {'Normal' if salary_shapiro_p > 0.05 else 'Non-normal'}\")\n",
        "\n",
        "# Distribution Visualizations\n",
        "print(f\"\\n8. Distribution Visualizations:\")\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
