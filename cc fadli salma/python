        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy import stats\n",
        "\n",
        "# Load the dataset\n",
        "df = pd.read_csv('/content/archive (1).zip')\n",
        "\n",
        "print(\"Purchase Rate Analysis Report\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "# 1. Overall purchase rate\n",
        "overall_purchase_rate = df['Purchased'].mean()\n",
        "total_users = len(df)\n",
        "total_purchases = df['Purchased'].sum()\n",
        "\n",
        "print(f\"\\n1. Overall Purchase Metrics:\")\n",
        "print(f\"Total Users: {total_users}\")\n",
        "print(f\"Total Purchases: {total_purchases}\")\n",
        "print(f\"Overall Purchase Rate: {overall_purchase_rate:.2%}\")\n",
        "print(f\"Confidence Interval (95%): {overall_purchase_rate:.2%} ± {1.96 * np.sqrt(overall_purchase_rate * (1-overall_purchase_rate) / total_users):.2%}\")\n",
        "\n",
        "# 2. Purchase rate by age segments\n",
        "print(f\"\\n2. Purchase Rate by Age Segments:\")\n",
        "\n",
        "# Define age segments\n",
        "age_segments = [\n",
        "    (18, 25, \"18-25: Gen Z\"),\n",
        "    (26, 35, \"26-35: Younger Millennials\"),\n",
        "    (36, 45, \"36-45: Older Millennials\"),\n",
        "    (46, 55, \"46-55: Gen X\"),\n",
        "    (56, 100, \"56+: Baby Boomers\")\n",
        "]\n",
        "\n",
        "age_analysis = []\n",
        "for min_age, max_age, label in age_segments:\n",
        "    segment_data = df[(df['Age'] >= min_age) & (df['Age'] <= max_age)]\n",
        "    if len(segment_data) > 0:\n",
        "        count = len(segment_data)\n",
        "        purchases = segment_data['Purchased'].sum()\n",
        "        rate = segment_data['Purchased'].mean()\n",
        "        avg_salary = segment_data['EstimatedSalary'].mean()\n",
        "\n",
        "        age_analysis.append({\n",
        "            'Segment': label,\n",
        "            'Count': count,\n",
        "            'Purchases': purchases,\n",
        "            'Rate': f\"{rate:.2%}\",\n",
        "            'Avg_Salary': f\"${avg_salary:,.0f}\"\n",
        "        })\n",
        "\n",
        "        print(f\"{label}: {count} users, {purchases} purchases, {rate:.2%} rate (Avg Salary: ${avg_salary:,.0f})\")\n",
        "\n",
        "# 3. Purchase rate by salary segments\n",
        "print(f\"\\n3. Purchase Rate by Salary Segments:\")\n",
        "\n",
        "# Define salary segments\n",
        "salary_segments = [\n",
        "    (0, 30000, \"Low Income: <$30k\"),\n",
        "    (30000, 50000, \"Lower Middle: $30k-$50k\"),\n",
        "    (50000, 75000, \"Middle: $50k-$75k\"),\n",
        "    (75000, 100000, \"Upper Middle: $75k-$100k\"),\n",
        "    (100000, 150000, \"High: $100k-$150k\"),\n",
        "    (150000, 200000, \"Very High: $150k+\")\n",
        "]\n",
        "\n",
        "salary_analysis = []\n",
        "for min_salary, max_salary, label in salary_segments:\n",
        "    segment_data = df[(df['EstimatedSalary'] >= min_salary) & (df['EstimatedSalary'] < max_salary)]\n",
        "    if len(segment_data) > 0:\n",
        "        count = len(segment_data)\n",
        "        purchases = segment_data['Purchased'].sum()\n",
        "        rate = segment_data['Purchased'].mean()\n",
        "        avg_age = segment_data['Age'].mean()\n",
        "\n",
        "        salary_analysis.append({\n",
        "            'Segment': label,\n",
        "            'Count': count,\n",
        "            'Purchases': purchases,\n",
        "            'Rate': f\"{rate:.2%}\",\n",
        "            'Avg_Age': f\"{avg_age:.1f}\"\n",
        "        })\n",
        "\n",
        "        print(f\"{label}: {count} users, {purchases} purchases, {rate:.2%} rate (Avg Age: {avg_age:.1f})\")\n",
        "\n",
        "# 4. Combined age-salary analysis\n",
        "print(f\"\\n4. Purchase Rate by Combined Demographics:\")\n",
        "\n",
        "# Create combined segments\n",
        "df_temp = df.copy()\n",
        "df_temp['Age_Group'] = pd.cut(df_temp['Age'], bins=[0, 35, 45, 100], labels=['Young', 'Middle', 'Senior'])\n",
        "df_temp['Salary_Group'] = pd.cut(df_temp['EstimatedSalary'], bins=[0, 60000, 100000, 200000], labels=['Low', 'Medium', 'High'])\n",
        "\n",
        "combined_analysis = df_temp.groupby(['Age_Group', 'Salary_Group'], observed=False).agg({\n",
        "    'Purchased': ['count', 'sum', 'mean']\n",
        "}).round(3)\n",
        "\n",
        "combined_analysis.columns = ['Count', 'Purchases', 'Rate']\n",
        "print(combined_analysis)\n",
        "\n",
        "# 5. Statistical significance testing\n",
        "print(f\"\\n5. Statistical Significance Tests:\")\n",
        "\n",
        "# Test if purchase rates differ significantly across age groups\n",
        "age_groups = [df[df['Age'] <= 35]['Purchased'].values,\n",
        "              df[(df['Age'] > 35) & (df['Age'] <= 45)]['Purchased'].values,\n",
        "              df[df['Age'] > 45]['Purchased'].values]\n",
        "\n",
        "# Remove empty groups\n",
        "age_groups = [group for group in age_groups if len(group) > 0]\n",
        "\n",
        "if len(age_groups) >= 2:\n",
        "    f_stat, p_value = stats.f_oneway(*age_groups)\n",
        "    print(f\"Age groups purchase rate comparison (ANOVA): F = {f_stat:.4f}, p-value = {p_value:.6f}\")\n",
        "\n",
        "# Test if purchase rates differ significantly across salary groups\n",
        "salary_groups = [df[df['EstimatedSalary'] <= 60000]['Purchased'].values,\n",
        "                 df[(df['EstimatedSalary'] > 60000) & (df['EstimatedSalary'] <= 100000)]['Purchased'].values,\n",
        "                 df[df['EstimatedSalary'] > 100000]['Purchased'].values]\n",
        "\n",
        "# Remove empty groups\n",
        "salary_groups = [group for group in salary_groups if len(group) > 0]\n",
        "\n",
        "if len(salary_groups) >= 2:\n",
        "    f_stat, p_value = stats.f_oneway(*salary_groups)\n",
        "    print(f\"Salary groups purchase rate comparison (ANOVA): F = {f_stat:.4f}, p-value = {p_value:.6f}\")\n",
        "\n",
        "# 6. Purchase rate trends\n",
        "print(f\"\\n6. Purchase Rate Trends:\")\n",
        "\n",
        "# Age trend analysis (rolling window)\n",
        "age_sorted = df.sort_values('Age')\n",
        "window_size = 50\n",
        "age_trends = []\n",
        "\n",
        "for i in range(len(age_sorted) - window_size + 1):\n",
        "    window_data = age_sorted.iloc[i:i+window_size]\n",
        "    avg_age = window_data['Age'].mean()\n",
        "    purchase_rate = window_data['Purchased'].mean()\n",
        "    age_trends.append((avg_age, purchase_rate))\n",
        "\n",
        "print(f\"Age trend (50-user rolling window):\")\n",
        "print(f\"Youngest 50 users (avg age {age_trends[0][0]:.1f}): {age_trends[0][1]:.2%} purchase rate\")\n",
        "print(f\"Middle 50 users (avg age {age_trends[len(age_trends)//2][0]:.1f}): {age_trends[len(age_trends)//2][1]:.2%} purchase rate\")\n",
        "print(f\"Oldest 50 users (avg age {age_trends[-1][0]:.1f}): {age_trends[-1][1]:.2%} purchase rate\")\n",
        "\n",
        "# 7. High-value segment identification\n",
        "print(f\"\\n7. High-Value Segment Analysis:\")\n",
        "\n",
        "# Find segments with highest purchase rates and minimum sample size\n",
        "min_sample_size = 20\n",
        "high_value_segments = []\n",
        "\n",
        "for age_min in range(18, 55, 5):\n",
        "    for salary_min in range(20000, 140000, 20000):\n",
        "        segment = df[\n",
        "            (df['Age'] >= age_min) & (df['Age'] < age_min + 10) &\n",
        "            (df['EstimatedSalary'] >= salary_min) & (df['EstimatedSalary'] < salary_min + 30000)\n",
        "        ]\n",
        "\n",
        "        if len(segment) >= min_sample_size:\n",
        "            purchase_rate = segment['Purchased'].mean()\n",
        "            if purchase_rate > 0.6:  # High purchase rate threshold\n",
        "                high_value_segments.append({\n",
        "                    'Age_Range': f\"{age_min}-{age_min+9}\",\n",
        "                    'Salary_Range': f\"${salary_min//1000}k-${(salary_min+30000)//1000}k\",\n",
        "                    'Count': len(segment),\n",
        "                    'Purchase_Rate': f\"{purchase_rate:.2%}\",\n",
        "                    'Revenue_Potential': len(segment) * purchase_rate\n",
        "                })\n",
        "\n",
        "print(\"High-value segments (>60% purchase rate, >20 users):\")\n",
        "for segment in sorted(high_value_segments, key=lambda x: x['Revenue_Potential'], reverse=True):\n",
        "    print(f\"Age {segment['Age_Range']}, Salary {segment['Salary_Range']}: \"\n",
        "          f\"{segment['Count']} users, {segment['Purchase_Rate']} rate, \"\n",
        "          f\"{segment['Revenue_Potential']:.1f} expected purchases\")\n",
        "\n",
        "# 8. Purchase rate confidence intervals\n",
        "print(f\"\\n8. Purchase Rate Confidence Intervals by Segment:\")\n",
        "\n",
        "def calculate_confidence_interval(successes, total, confidence_level=0.95):\n",
        "    if total == 0:\n",
        "        return 0, 0, 0\n",
        "\n",
        "    p = successes / total\n",
        "    z = stats.norm.ppf(1 - (1 - confidence_level) / 2)\n",
        "    margin_of_error = z * np.sqrt(p * (1 - p) / total)\n",
        "\n",
        "    return p, max(0, p - margin_of_error), min(1, p + margin_of_error)\n",
        "\n",
        "# Calculate confidence intervals for major segments\n",
        "major_segments = [\n",
        "    (\"Young (<=35)\", df[df['Age'] <= 35]),\n",
        "    (\"Middle (36-45)\", df[(df['Age'] > 35) & (df['Age'] <= 45)]),\n",
        "    (\"Senior (>45)\", df[df['Age'] > 45]),\n",
        "    (\"Low Salary (<=60k)\", df[df['EstimatedSalary'] <= 60000]),\n",
        "    (\"Medium Salary (60k-100k)\", df[(df['EstimatedSalary'] > 60000) & (df['EstimatedSalary'] <= 100000)]),\n",
        "    (\"High Salary (>100k)\", df[df['EstimatedSalary'] > 100000])\n",
        "]\n",
        "\n",
        "for segment_name, segment_data in major_segments:\n",
        "    if len(segment_data) > 0:\n",
        "        purchases = segment_data['Purchased'].sum()\n",
        "        total = len(segment_data)\n",
        "        rate, lower_ci, upper_ci = calculate_confidence_interval(purchases, total)\n",
        "\n",
        "        print(f\"{segment_name}: {rate:.2%} (95% CI: {lower_ci:.2%} - {upper_ci:.2%})\")"
      ]
