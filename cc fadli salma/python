        "\n",
        "    # Evaluate tuned model on test set\n",
        "    X_test_tune = X_test_scaled if best_model_name in ['Logistic Regression', 'SVM (RBF)', 'K-Nearest Neighbors'] else X_test\n",
        "    tuned_predictions = grid_search.predict(X_test_tune)\n",
