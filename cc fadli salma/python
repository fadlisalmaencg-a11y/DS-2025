        "print(classification_report(y_test, best_model['predictions']))\n",
        "\n",
        "# 6. Feature importance (for tree-based models)\n",
        "if best_model_name in ['Decision Tree', 'Random Forest', 'Gradient Boosting']:\n",
        "    feature_importance = best_model['model'].feature_importances_\n",
        "    print(f\"\\n6. Feature Importance ({best_model_name}):\")\n",
        "    for feature, importance in zip(['Age', 'EstimatedSalary'], feature_importance):\n",
        "        print(f\"  {feature}: {importance:.4f}\")\n",
        "\n",
        "# 7. Hyperparameter tuning for best model\n",
        "print(f\"\\n7. Hyperparameter Tuning for {best_model_name}:\")\n",
        "\n",
        "if best_model_name == 'Logistic Regression':\n",
        "    param_grid = {'C': [0.1, 1, 10, 100]}\n",
